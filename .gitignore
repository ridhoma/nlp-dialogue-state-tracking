# ==============================================================================
# Git Ignore Configuration for NLP Dialogue State Tracking
# Ensures NO dataset files, models, or sensitive credentials can be tracked.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Data Content & Storage (Strict: No data content pushed)
# ------------------------------------------------------------------------------
# Ignore all contents of data/ directories while preserving folder structure
data/*
!data/.gitkeep
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep
!data/samples/
data/samples/*
!data/samples/.gitkeep

# Catch-all for logs anywhere in the project
*.log

# Catch-all for data and model serialization formats anywhere in the project
*.parquet
*.feather
*.arrow
*.db
*.sqlite
*.sqlite3
*.csv
*.tsv
*.jsonl
*.gz
*.tar
*.zip
*.7z
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.hdf5
*.pt
*.pth
*.bin
*.onnx
*.safetensors

# ------------------------------------------------------------------------------
# 2. Sensitive Files, Credentials & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*secret*
*credential*
*token*
client_secret*.json
service_account*.json
credentials.json
.netrc
.aws/
.gcloud/

# ------------------------------------------------------------------------------
# 3. Virtual Environments, Packages & Python Build Artifacts
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ------------------------------------------------------------------------------
# 4. Jupyter Notebook Checkpoints & Outputs
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ------------------------------------------------------------------------------
# 5. Testing, Linting & Experiment Trackers
# ------------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
wandb/
mlruns/
lightning_logs/

# ------------------------------------------------------------------------------
# 6. Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
